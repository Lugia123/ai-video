          "start": 104.698,
          "end": 109.34
        }
      ]
    },
    {
      "id": "s11",
      "text": "这就是开头那“二十行”的秘密。",
      "start": 110.24,
      "end": 112.373,
      "sentences": [
        {
          "text": "这就是开头那“二十行”的秘密。",
          "start": 110.24,
